# Copy this file to .env and replace every value before starting RezTV:
#   cp .env.example .env
# Never commit your real .env file (it is listed in .gitignore).

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Database password (generate one with: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional: largest upload in MB (default 2048 = 2 GB). Keep nginx client_max_body_size in step.
# MAX_UPLOAD_MB=2048
# Optional: failed admin logins allowed per address in the window (seconds) before lockout
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900

# Optional: upload conversion. Every upload is converted once to this station format.
# STATION_RESOLUTION=1920x1080      # width x height (even numbers); smaller videos are letterboxed
# STATION_FPS=30
# STATION_LOUDNORM=true             # even out volume between videos (true/false)
# STATION_LOUDNORM_TARGET=-16       # loudness target in LUFS
# GIF_MIN_SECONDS=30                # short GIFs are looped until they last at least this long
# KEEP_ORIGINALS=false              # true keeps the file as uploaded next to the converted one

# Optional: Separate audio channels. Music is evened out once on upload (STATION_LOUDNORM);
# set this to true to also even it out live while streaming (uses a little extra CPU).
# STREAM_AUDIO_LOUDNORM=false

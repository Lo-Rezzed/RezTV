# Copy this file to .env and replace every value before starting RezTV:
#   cp .env.example .env
# Never commit your real .env file (it is listed in .gitignore).

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Database password (generate one with: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional: largest upload in MB (default 2048 = 2 GB). Keep nginx client_max_body_size in step.
# MAX_UPLOAD_MB=2048
# Optional: failed admin logins allowed per address in the window (seconds) before lockout
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
